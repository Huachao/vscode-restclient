{
    "name": "rest-client",
    "displayName": "REST Client",
    "description": "%ext.description%",
    "version": "1.2.0",
    "publisher": "vscode-restclient",
    "author": {
        "name": "The Visual Studio Code REST Client Team",
        "url": "https://github.com/vscode-restclient/vscode-restclient"
    },
    "contributors": [
        {
            "name": "Huachao Mao (original author of REST Client)",
            "url": "https://github.com/Huachao/vscode-restclient"
        }
    ],
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#0F1A24",
        "theme": "dark"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vscode-restclient/vscode-restclient/issues"
    },
    "homepage": "https://github.com/vscode-restclient/vscode-restclient#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/vscode-restclient/vscode-restclient.git"
    },
    "engines": {
        "vscode": "^1.81.0"
    },
    "categories": [
        "Other",
        "Snippets",
        "Linters",
        "Programming Languages"
    ],
    "keywords": [
        "http",
        "rest",
        "api",
        "http client",
        "rest client",
        "request",
        "curl",
        "graphql",
        "testing",
        "postman alternative"
    ],
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "main": "./dist/extension",
    "contributes": {
        "languages": [
            {
                "id": "http",
                "aliases": [
                    "HTTP",
                    "Http",
                    "http"
                ],
                "extensions": [
                    ".http",
                    ".rest"
                ],
                "firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE|LOCK|UNLOCK|PROPFIND|PROPPATCH|COPY|MOVE|MKCOL|MKCALENDAR|ACL|SEARCH)\\s+(.*?)HTTP/[0-9\\.]+$",
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "http",
                "scopeName": "source.http",
                "path": "./syntaxes/http.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "http",
                "path": "./snippets/http.json"
            }
        ],
        "commands": [
            {
                "command": "rest-client.request",
                "title": "%cmd.request%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.rerun-last-request",
                "title": "%cmd.rerun-last-request%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.cancel-request",
                "title": "%cmd.cancel-request%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.switch-environment",
                "title": "%cmd.switch-environment%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.history",
                "title": "%cmd.history%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.clear-history",
                "title": "%cmd.clear-history%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.save-response",
                "title": "%cmd.save-response%",
                "icon": {
                    "light": "./images/save.svg",
                    "dark": "./images/save-inverse.svg"
                },
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.save-response-body",
                "title": "%cmd.save-response-body%",
                "icon": {
                    "light": "./images/save-body.svg",
                    "dark": "./images/save-body-inverse.svg"
                },
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.copy-response-body",
                "title": "%cmd.copy-response-body%",
                "icon": {
                    "light": "./images/copy.svg",
                    "dark": "./images/copy-inverse.svg"
                },
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.generate-codesnippet",
                "title": "%cmd.generate-codesnippet%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.copy-codesnippet",
                "title": "%cmd.copy-codesnippet%",
                "icon": {
                    "light": "./images/copy.svg",
                    "dark": "./images/copy-inverse.svg"
                },
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.copy-request-as-curl",
                "title": "%cmd.copy-request-as-curl%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.clear-aad-token-cache",
                "title": "%cmd.clear-aad-token-cache%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.clear-cookies",
                "title": "%cmd.clear-cookies%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.fold-response",
                "title": "%cmd.fold-response%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.unfold-response",
                "title": "%cmd.unfold-response%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.preview-html-response-body",
                "title": "%cmd.preview-html-response-body%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.show-raw-response",
                "title": "%cmd.show-raw-response%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.import-swagger",
                "title": "%cmd.import-swagger%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.set-secret",
                "title": "%cmd.set-secret%",
                "category": "HttpKeeper"
            },
            {
                "command": "rest-client.delete-secret",
                "title": "%cmd.delete-secret%",
                "category": "HttpKeeper"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "rest-client.fold-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "rest-client.unfold-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "rest-client.preview-html-response-body",
                    "when": "isHTMLResponse"
                },
                {
                    "command": "rest-client.show-raw-response",
                    "when": "isHTMLResponse"
                },
                {
                    "command": "rest-client.save-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "rest-client.save-response-body",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "rest-client.copy-response-body",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "rest-client.copy-codesnippet",
                    "when": "codeSnippetPreviewFocus"
                }
            ],
            "editor/title": [
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "rest-client.save-response",
                    "group": "navigation@1"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "rest-client.save-response-body",
                    "group": "navigation@2"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "rest-client.copy-response-body",
                    "group": "navigation@3"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "rest-client.fold-response",
                    "group": "1_rest-client@1"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "rest-client.unfold-response",
                    "group": "1_rest-client@2"
                },
                {
                    "when": "isHTMLResponse",
                    "command": "rest-client.preview-html-response-body",
                    "group": "1_rest-client@3"
                },
                {
                    "when": "isHTMLResponse",
                    "command": "rest-client.show-raw-response",
                    "group": "1_rest-client@4"
                },
                {
                    "when": "codeSnippetPreviewFocus",
                    "command": "rest-client.copy-codesnippet",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "rest-client.request",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@1"
                },
                {
                    "command": "rest-client.generate-codesnippet",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@2"
                },
                {
                    "command": "rest-client.copy-request-as-curl",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@3"
                }
            ]
        },
        "keybindings": [
            {
                "command": "rest-client.request",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "rest-client.request",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "rest-client.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "rest-client.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "rest-client.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "httpResponsePreviewFocus"
            },
            {
                "command": "rest-client.cancel-request",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "rest-client.cancel-request",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "rest-client.history",
                "key": "ctrl+alt+h",
                "mac": "cmd+alt+h"
            },
            {
                "command": "rest-client.switch-environment",
                "key": "ctrl+alt+e",
                "mac": "cmd+alt+e"
            },
            {
                "command": "rest-client.generate-codesnippet",
                "key": "ctrl+alt+c",
                "mac": "cmd+alt+c",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "rest-client.generate-codesnippet",
                "key": "ctrl+alt+c",
                "mac": "cmd+alt+c",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "HttpKeeper",
            "properties": {
                "httpkeeper.followredirect": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.followredirect%"
                },
                "httpkeeper.defaultHeaders": {
                    "type": "object",
                    "default": {
                        "User-Agent": "vscode-restclient"
                    },
                    "scope": "resource",
                    "description": "%cfg.defaultHeaders%"
                },
                "httpkeeper.timeoutinmilliseconds": {
                    "type": "integer",
                    "default": 0,
                    "scope": "resource",
                    "description": "%cfg.timeoutinmilliseconds%"
                },
                "httpkeeper.showResponseInDifferentTab": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "%cfg.showResponseInDifferentTab%"
                },
                "httpkeeper.requestNameAsResponseTabTitle": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "%cfg.requestNameAsResponseTabTitle%"
                },
                "httpkeeper.rememberCookiesForSubsequentRequests": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.rememberCookiesForSubsequentRequests%"
                },
                "httpkeeper.excludeHostsForProxy": {
                    "type": "array",
                    "default": [],
                    "scope": "resource",
                    "description": "%cfg.excludeHostsForProxy%"
                },
                "httpkeeper.fontSize": {
                    "type": "number",
                    "scope": "resource",
                    "markdownDescription": "%cfg.fontSize%"
                },
                "httpkeeper.fontFamily": {
                    "type": "string",
                    "default": null,
                    "scope": "resource",
                    "description": "%cfg.fontFamily%"
                },
                "httpkeeper.fontWeight": {
                    "type": "string",
                    "enum": [
                        "normal",
                        "bold",
                        "bolder",
                        "lighter",
                        "100",
                        "200",
                        "300",
                        "400",
                        "500",
                        "600",
                        "700",
                        "800",
                        "900"
                    ],
                    "scope": "resource",
                    "description": "%cfg.fontWeight%"
                },
                "httpkeeper.environmentVariables": {
                    "type": "object",
                    "default": {
                        "$shared": {}
                    },
                    "scope": "resource",
                    "markdownDescription": "%cfg.environmentVariables%",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Sets the custom variables belong to this environment",
                                "additionalProperties": {
                                    "anyOf": [
                                        {
                                            "type": "string",
                                            "description": "Value of the custom variable"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.mimeAndFileExtensionMapping": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string"
                            }
                        ]
                    },
                    "markdownDescription": "%cfg.mimeAndFileExtensionMapping%"
                },
                "httpkeeper.previewResponseInUntitledDocument": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "%cfg.previewResponseInUntitledDocument%"
                },
                "httpkeeper.oidcScopes": {
                    "type": "array",
                    "default": [],
                    "scope": "resource",
                    "description": "%cfg.oidcScopes%"
                },
                "httpkeeper.oidcCertificates": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "description": "%cfg.oidcCertificates%",
                    "pattern": "^(?!http(s?)://)",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Certifcate paths for Oidc callback server",
                                "properties": {
                                    "cert": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Public x509 certificate"
                                    },
                                    "key": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Private key"
                                    },
                                    "pfx": {
                                        "type": "string",
                                        "description": "Absolute or relative path of PKCS #12 certificate"
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "description": "[Optional] A string of passphrase for the private key or pfx"
                                    }
                                },
                                "dependencies": {
                                    "cert": [
                                        "key"
                                    ],
                                    "key": [
                                        "cert"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.certificates": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "description": "%cfg.certificates%",
                    "pattern": "^(?!http(s?)://)",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Certifcate paths for specific host(e.g., foo.com, bar.org:8081), port is optional",
                                "properties": {
                                    "cert": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Public x509 certificate"
                                    },
                                    "key": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Private key"
                                    },
                                    "pfx": {
                                        "type": "string",
                                        "description": "Absolute or relative path of PKCS #12 certificate"
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "description": "[Optional] A string of passphrase for the private key or pfx"
                                    }
                                },
                                "dependencies": {
                                    "cert": [
                                        "key"
                                    ],
                                    "key": [
                                        "cert"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.suppressResponseBodyContentTypeValidationWarning": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "%cfg.suppressResponseBodyContentTypeValidationWarning%"
                },
                "httpkeeper.previewOption": {
                    "type": "string",
                    "enum": [
                        "full",
                        "headers",
                        "body",
                        "exchange"
                    ],
                    "enumDescriptions": [
                        "Response headers, body and status line",
                        "Response headers and status line",
                        "Response body only",
                        "Whole HTTP exchange including both request and response"
                    ],
                    "default": "full",
                    "scope": "resource",
                    "description": "%cfg.previewOption%"
                },
                "httpkeeper.disableHighlightResponseBodyForLargeResponse": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "%cfg.disableHighlightResponseBodyForLargeResponse%"
                },
                "httpkeeper.disableAddingHrefLinkForLargeResponse": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "%cfg.disableAddingHrefLinkForLargeResponse%"
                },
                "httpkeeper.largeResponseBodySizeLimitInMB": {
                    "type": "number",
                    "default": 5,
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "scope": "resource",
                    "markdownDescription": "%cfg.largeResponseBodySizeLimitInMB%"
                },
                "httpkeeper.previewColumn": {
                    "type": "string",
                    "enum": [
                        "current",
                        "beside"
                    ],
                    "markdownEnumDescriptions": [
                        "Preview in the column of current request file",
                        "previewing at the side of the current active column and the side direction depends on `workbench.editor.openSideBySideDirection` setting, either right or below the current editor column"
                    ],
                    "default": "beside",
                    "scope": "resource",
                    "description": "%cfg.previewColumn%"
                },
                "httpkeeper.previewResponsePanelTakeFocus": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.previewResponsePanelTakeFocus%"
                },
                "httpkeeper.formParamEncodingStrategy": {
                    "type": "string",
                    "enum": [
                        "automatic",
                        "never",
                        "always"
                    ],
                    "markdownEnumDescriptions": [
                        "Detecting encoding or not automatically and do the encoding job if necessary",
                        "Treat provided request body as is, no encoding job will be applied",
                        "Use for the scenario that `automatic` option not working properly, e.g., some special characters(`+`) are not encoded correctly"
                    ],
                    "default": "automatic",
                    "scope": "resource",
                    "markdownDescription": "%cfg.formParamEncodingStrategy%"
                },
                "httpkeeper.addRequestBodyLineIndentationAroundBrackets": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "%cfg.addRequestBodyLineIndentationAroundBrackets%"
                },
                "httpkeeper.decodeEscapedUnicodeCharacters": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "%cfg.decodeEscapedUnicodeCharacters%"
                },
                "httpkeeper.logLevel": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "verbose"
                    ],
                    "default": "error",
                    "scope": "resource",
                    "description": "%cfg.logLevel%"
                },
                "httpkeeper.enableSendRequestCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.enableSendRequestCodeLens%"
                },
                "httpkeeper.enableCustomVariableReferencesCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.enableCustomVariableReferencesCodeLens%"
                },
                "httpkeeper.useContentDispositionFilename": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "%cfg.useContentDispositionFilename%"
                }
            }
        },
        "configurationDefaults": {
            "[http]": {
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": false,
                    "strings": true
                }
            }
        },
        "languageModelTools": [
            {
                "name": "httpkeeper_send_request",
                "displayName": "Send an HTTP request from a .http file",
                "modelDescription": "Sends one request from a .http file in the workspace (by its # @name, or the first one if no name is given) and returns status, headers and body. Variables, environments and secrets are resolved the same way as when a person presses Send Request. Use it to check what an API really returns.",
                "userDescription": "Send a request from a .http file and read the response",
                "toolReferenceName": "httpkeeper",
                "canBeReferencedInPrompt": true,
                "icon": "$(arrow-swap)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "file": {
                            "type": "string",
                            "description": "Path of the .http file, relative to the workspace"
                        },
                        "name": {
                            "type": "string",
                            "description": "The # @name of the request. Omit to send the first request of the file"
                        }
                    },
                    "required": [
                        "file"
                    ]
                }
            },
            {
                "name": "httpkeeper_list_requests",
                "displayName": "List the requests in a .http file",
                "modelDescription": "Lists the requests (name, method, url, line) defined in a .http file of the workspace. Nothing is sent.",
                "userDescription": "List the requests of a .http file",
                "toolReferenceName": "httpkeeperList",
                "canBeReferencedInPrompt": true,
                "icon": "$(list-unordered)",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "file": {
                            "type": "string",
                            "description": "Path of the .http file, relative to the workspace"
                        }
                    },
                    "required": [
                        "file"
                    ]
                }
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "httpkeeper.mcp",
                "label": "HttpKeeper"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "webpack --mode production",
        "webpack": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "tslint": "tslint --project tsconfig.json",
        "compile-tests": "tsc -p tsconfig.test.json",
        "test:unit": "npm run compile-tests && mocha \"out-test/test/unit/**/*.test.js\"",
        "test:integration": "npm run compile-tests && npm run build && node ./out-test/test/integration/runTest.js",
        "test": "npm run test:unit && npm run test:integration",
        "build:cli": "tsc -p tsconfig.cli.json",
        "test:cli": "npm run build:cli && node scripts/probar-cli.mjs",
        "audit": "node scripts/auditoria.mjs",
        "check": "npx tsc -p ./ --noEmit --skipLibCheck && npm run test:unit && npm run build:cli && npm run test:cli && npm run test:mcp && npm run test:l10n && npm run audit && npm run test:vsix",
        "test:l10n": "node scripts/comprobar-l10n.mjs",
        "test:vsix": "node scripts/probar-vsix.mjs",
        "demo": "node scripts/demo/lanzar.mjs && node scripts/demo/montar.mjs",
        "build": "webpack --mode production",
        "test:mcp": "node scripts/probar-mcp.mjs",
        "preparar-npm": "node scripts/preparar-npm.mjs"
    },
    "devDependencies": {
        "@types/aws4": "^1.5.1",
        "@types/fs-extra": "^5.0.4",
        "@types/jws": "^3.2.10",
        "@types/mocha": "^5.2.7",
        "@types/node": "^20.19.43",
        "@types/node-fetch": "^2.6.11",
        "@types/vscode": "^1.81.0",
        "@vscode/test-electron": "^3.1.0",
        "glob": "^13.0.6",
        "mocha": "^10.8.2",
        "ts-loader": "^7.0.5",
        "tslint": "^6.1.2",
        "typescript": "^5.9.3",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1"
    },
    "dependencies": {
        "@faker-js/faker": "^10.6.0",
        "@xmldom/xmldom": "^0.9.12",
